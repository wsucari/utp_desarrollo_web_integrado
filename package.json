{
  "name": "inudi-academico-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/main/frontend/tailwind.css -o src/main/resources/static/assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i src/main/frontend/tailwind.css -o src/main/resources/static/assets/tailwind.css --watch",
    "build:ui": "npm run build:css && npm --prefix frontend run build",
    "test:ui": "npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
