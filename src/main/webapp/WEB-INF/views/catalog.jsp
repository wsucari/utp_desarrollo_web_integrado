<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<div class="tw-bg-slate-50 tw-text-slate-950">
<section class="tw-border-b tw-border-slate-200 tw-bg-white"><div class="tw-mx-auto tw-grid tw-max-w-screen-xl tw-gap-8 tw-px-4 tw-py-8 sm:tw-px-6 lg:tw-grid-cols-[minmax(0,1fr)_320px] lg:tw-px-8">
<div><p class="tw-text-sm tw-font-bold tw-uppercase tw-tracking-wide tw-text-[#D4A017]">InudiClass</p><h1 class="tw-mt-2 tw-text-3xl md:tw-text-4xl tw-font-bold tw-leading-tight tw-text-[#0E2F66]">¿Qué deseas lograr hoy?</h1>
<p class="tw-mt-3 tw-max-w-3xl tw-text-base tw-leading-7 tw-text-[#64748B]">Explora formación especializada en investigación científica, tesis, publicación académica, inteligencia artificial, estadística y docencia universitaria.</p>
<form method="get" action="${ctx}/" class="tw-mt-6"><input type="hidden" name="ruta" value="<c:out value='${ruta}'/>"/><input type="hidden" name="acceso" value="<c:out value='${acceso}'/>"/>
<div class="tw-flex tw-flex-col sm:tw-flex-row tw-gap-3 tw-rounded-lg tw-border tw-border-slate-200 tw-bg-slate-50 tw-p-2 tw-shadow-sm"><input type="search" name="search" value="<c:out value='${search}'/>" placeholder="Buscar cursos, temas, metodologías o docentes" aria-label="Buscar cursos" maxlength="180" class="tw-h-12 tw-w-full tw-flex-1 tw-rounded-md tw-border tw-border-transparent tw-bg-white tw-px-4 tw-text-sm"/><button class="tw-h-12 tw-rounded-md tw-bg-[#0E2F66] tw-px-6 tw-text-sm tw-font-bold tw-text-white tw-border-0">Buscar</button></div></form></div>
<div class="tw-rounded-lg tw-border tw-border-[#D4A017]/35 tw-bg-[#D4A017]/10 tw-p-5"><p class="tw-text-sm tw-font-bold tw-text-[#0E2F66]">Aprendizaje orientado a resultados</p><p class="tw-mt-2 tw-text-sm tw-leading-6 tw-text-[#64748B]">Elige una ruta académica y avanza desde el fundamento hasta la aplicación práctica en investigación y docencia.</p><div class="tw-mt-4 tw-grid tw-grid-cols-2 tw-gap-3 tw-text-sm"><div class="tw-rounded-md tw-bg-white tw-p-3"><strong class="tw-block tw-text-lg tw-text-[#0E2F66]">${accessCounts.todos}</strong><span class="tw-text-[#64748B]">Cursos</span></div><div class="tw-rounded-md tw-bg-white tw-p-3"><strong class="tw-block tw-text-lg tw-text-[#0E2F66]">${accessCounts.inscritos}</strong><span class="tw-text-[#64748B]">Inscritos</span></div></div></div>
</div></section>
<section class="tw-mx-auto tw-max-w-screen-xl tw-px-4 tw-py-8 sm:tw-px-6 lg:tw-px-8"><h2 class="tw-text-2xl tw-font-bold tw-text-[#0E2F66]">Rutas académicas</h2><p class="tw-mt-1 tw-text-sm tw-text-[#64748B]">Navega por objetivos reales de investigadores y docentes universitarios.</p>
<div class="tw-mt-4 tw-grid tw-grid-cols-1 tw-gap-4 sm:tw-grid-cols-2 lg:tw-grid-cols-3 xl:tw-grid-cols-6"><c:forEach items="${academicRoutes}" var="route"><a href="<c:out value='${ctx}${routeLinks[route.slug]}'/>" class="tw-block tw-rounded-lg tw-border tw-p-4 tw-bg-white hover:tw-border-[#1E4E9B] ${ruta == route.slug ? 'tw-border-[#0E2F66]' : 'tw-border-slate-200'}"><h3 class="tw-text-sm tw-font-bold tw-text-[#0E2F66]"><c:out value="${route.title}"/></h3><p class="tw-mt-2 tw-text-xs tw-leading-5 tw-text-[#64748B]"><c:out value="${route.description}"/></p></a></c:forEach></div></section>
<c:if test="${not empty continueCourses}"><section class="tw-mx-auto tw-max-w-screen-xl tw-px-4 tw-pb-8 sm:tw-px-6 lg:tw-px-8"><h2 class="tw-text-2xl tw-font-bold tw-text-[#0E2F66]">Continuar aprendiendo</h2><p class="tw-mt-1 tw-text-sm tw-text-[#64748B]">Retoma los cursos en los que ya tienes acceso activo.</p><div class="tw-mt-4 tw-grid tw-grid-cols-1 md:tw-grid-cols-2 xl:tw-grid-cols-4 tw-gap-5"><c:forEach items="${continueCourses}" var="course"><ui:courseCard course="${course}"/></c:forEach></div></section></c:if>
<c:if test="${not empty featuredCourses}"><section class="tw-mx-auto tw-max-w-screen-xl tw-px-4 tw-pb-8 sm:tw-px-6 lg:tw-px-8"><h2 class="tw-text-2xl tw-font-bold tw-text-[#0E2F66]">Cursos destacados</h2><p class="tw-mt-1 tw-text-sm tw-text-[#64748B]">Programas relevantes para fortalecer tu producción académica.</p><div class="tw-mt-4 tw-grid tw-grid-cols-1 md:tw-grid-cols-2 lg:tw-grid-cols-3 xl:tw-grid-cols-4 tw-gap-5"><c:forEach items="${featuredCourses}" var="course"><ui:courseCard course="${course}"/></c:forEach></div></section></c:if>
<section class="tw-mx-auto tw-max-w-screen-xl tw-px-4 tw-pb-10 sm:tw-px-6 lg:tw-px-8"><div class="tw-flex tw-flex-wrap tw-items-end tw-justify-between tw-gap-4"><div><h2 class="tw-text-2xl tw-font-bold tw-text-[#0E2F66]">Todos los cursos</h2><p class="tw-mt-1 tw-text-sm tw-text-[#64748B]">${fn:length(courses)} resultados disponibles.</p></div><div class="tw-flex tw-flex-wrap tw-gap-2"><a href="<c:out value='${ctx}${routeLinks[""]}'/>" class="tw-rounded-full tw-border tw-border-slate-200 tw-bg-white tw-px-4 tw-py-2 tw-text-sm tw-font-semibold">Todos</a><c:forEach items="${academicRoutes}" var="route"><a href="<c:out value='${ctx}${routeLinks[route.slug]}'/>" class="tw-rounded-full tw-border tw-px-4 tw-py-2 tw-text-sm tw-font-semibold ${ruta == route.slug ? 'tw-bg-[#0E2F66] tw-text-white tw-border-[#0E2F66]' : 'tw-border-slate-200 tw-bg-white'}"><c:out value="${route.label}"/></a></c:forEach><button type="button" data-toggle-target="course-filters" aria-controls="course-filters" aria-expanded="false" class="tw-rounded-full tw-border tw-border-slate-200 tw-bg-white tw-px-4 tw-py-2 tw-text-sm tw-font-semibold">Más filtros</button></div></div>
<div class="tw-my-5 tw-flex tw-flex-wrap tw-gap-2"><c:forTokens items="todos,inscritos,disponibles" delims="," var="key"><a href="<c:out value='${ctx}${accessLinks[key]}'/>" class="tw-rounded-full tw-border tw-px-4 tw-py-2 tw-text-sm tw-font-semibold ${acceso == key ? 'tw-bg-[#0E2F66] tw-text-white tw-border-[#0E2F66]' : 'tw-border-slate-200 tw-bg-white'}">${key == 'todos' ? 'Todos' : key == 'inscritos' ? 'Mis cursos' : 'No inscritos'} <span>${accessCounts[key]}</span></a></c:forTokens></div>
<form id="course-filters" method="get" action="${ctx}/" class="tw-hidden tw-rounded-lg tw-border tw-border-slate-200 tw-bg-white tw-p-5 tw-mb-5"><h3 class="tw-text-lg tw-font-bold">Filtros de cursos</h3><div class="tw-grid tw-gap-4 md:tw-grid-cols-3 tw-my-4"><label>Buscar<input name="search" value="<c:out value='${search}'/>" class="tw-block tw-w-full"/></label><label>Ruta académica<select name="ruta" class="tw-block tw-w-full"><option value="">Todas</option><c:forEach items="${academicRoutes}" var="route"><option value="${route.slug}" ${ruta == route.slug ? 'selected' : ''}><c:out value="${route.title}"/></option></c:forEach></select></label><label>Vista<select name="acceso" class="tw-block tw-w-full"><option value="todos" ${acceso == 'todos' ? 'selected' : ''}>Todos</option><option value="inscritos" ${acceso == 'inscritos' ? 'selected' : ''}>Mis cursos</option><option value="disponibles" ${acceso == 'disponibles' ? 'selected' : ''}>No inscritos</option></select></label><label>Categoría<select name="categoria" class="tw-block tw-w-full"><option value="">Todas</option><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat}'/>" ${categoria == cat ? 'selected' : ''}><c:out value="${cat}"/></option></c:forEach></select></label><label>Nivel<select name="nivel" class="tw-block tw-w-full"><option value="">Todos</option><c:forEach items="${levels}" var="lvl"><option value="<c:out value='${lvl}'/>" ${nivel == lvl ? 'selected' : ''}><c:out value="${lvl}"/></option></c:forEach></select></label></div><a href="${ctx}/" class="tw-mr-4">Limpiar</a><button class="tw-rounded-md tw-bg-[#0E2F66] tw-px-4 tw-py-2 tw-border-0 tw-text-white">Aplicar filtros</button></form>
<div class="tw-grid tw-grid-cols-1 tw-gap-5 md:tw-grid-cols-2 lg:tw-grid-cols-3 xl:tw-grid-cols-4"><c:forEach items="${courses}" var="course"><ui:courseCard course="${course}"/></c:forEach></div>
<c:if test="${empty courses}"><div class="tw-rounded-lg tw-border tw-border-dashed tw-border-slate-300 tw-bg-white tw-p-10 tw-text-center"><h3 class="tw-text-lg tw-font-bold">No encontramos cursos con esos criterios</h3><p class="tw-mt-2 tw-text-sm tw-text-[#64748B]">Prueba otra palabra clave o limpia los filtros para revisar todo el catálogo.</p><a href="${ctx}/" class="tw-inline-block tw-mt-5 tw-rounded-md tw-bg-[#0E2F66] tw-px-4 tw-py-2 tw-text-white">Ver todo el catálogo</a></div></c:if></section></div>
<%@ include file="fragments/footer.jspf" %>
