<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<div class="page-heading"><h1>Mi perfil</h1></div><div class="two-column"><section class="panel"><h2>Información personal</h2><form action="${ctx}/perfil" method="post" class="stack-form"><%@ include file="fragments/csrf.jspf" %><label>Nombre completo<input name="fullName" value="<c:out value='${user.fullName}'/>" maxlength="120" required/></label><label>Correo electrónico<input type="email" value="<c:out value='${user.email}'/>" disabled/></label><label>Teléfono<input name="phone" value="<c:out value='${user.phone}'/>" maxlength="30"/></label><label>Especialidad o título profesional<input name="professionalTitle" value="<c:out value='${user.professionalTitle}'/>" maxlength="180"/></label><h3>Cambiar contraseña</h3><p class="muted small">Deja estos campos vacíos si solo deseas actualizar tus datos.</p><label>Contraseña actual<input type="password" name="oldPassword" autocomplete="current-password"/></label><label>Nueva contraseña<input type="password" name="newPassword" minlength="10" maxlength="72" autocomplete="new-password"/></label><small>Al menos 10 caracteres con mayúsculas, minúsculas y números.</small><button class="button">Guardar cambios</button></form></section><aside class="panel profile-summary"><span class="avatar avatar-large"><c:out value="${user.initials}"/></span><h2><c:out value="${user.fullName}"/></h2><span class="badge">${role}</span></aside></div>
<%@ include file="fragments/footer.jspf" %>
