<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<div class="page-heading with-action"><h1>${role == 'ADMIN' ? 'Cursos' : 'Mis cursos'}</h1><c:if test="${role == 'ADMIN'}"><a data-form-modal class="button" href="${ctx}/admin/cursos/nuevo">+ Crear curso</a></c:if></div>
<div class="management-grid"><c:forEach items="${courses}" var="course"><article class="panel management-card"><div class="management-card-top"><span class="stat-icon"><svg><use href="#i-book"/></svg></span><span class="badge ${course.published ? 'positive' : 'warning'}">${course.published ? 'PUBLICADO' : 'BORRADOR'}</span></div><span class="eyebrow"><c:out value="${course.category}"/></span><h2><c:out value="${course.title}"/></h2><p class="muted small"><c:out value="${course.teacherNames}"/></p><div class="management-card-actions"><a class="button button-small" href="${ctx}/gestion/cursos/${course.id}">Gestionar contenidos →</a><a class="text-link" href="${ctx}/gestion/cursos/${course.id}/seguimiento">Seguimiento académico ↗</a><c:if test="${role == 'ADMIN'}"><a data-form-modal class="text-link" href="${ctx}/admin/cursos/${course.id}/editar">Editar datos del curso</a></c:if></div></article></c:forEach></div><c:if test="${empty courses}"><div class="empty-state"><h2>No hay cursos asignados</h2><p>Los cursos aparecen cuando la administración los registra y asigna al docente.</p></div></c:if>
<%@ include file="../fragments/footer.jspf" %>
