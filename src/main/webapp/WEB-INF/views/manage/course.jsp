<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<a class="back-link" href="${ctx}/gestion/cursos">← Gestión de cursos</a><div class="page-heading"><span class="eyebrow">ORGANIZACIÓN DEL APRENDIZAJE</span><h1><c:out value="${course.title}"/></h1><div class="actions"><a class="button button-ghost" href="${ctx}/aula/cursos/${course.id}">Vista del aula ↗</a><a class="button" href="${ctx}/gestion/cursos/${course.id}/seguimiento">Seguimiento académico →</a><c:if test="${role == 'ADMIN'}"><a data-form-modal class="text-link" href="${ctx}/admin/cursos/${course.id}/editar">Editar curso</a></c:if></div></div>
<c:forEach items="${syllabus}" var="row"><section class="panel section-space"><div class="section-heading"><div><span class="eyebrow">MÓDULO ${row.module.position}</span><h2><c:out value="${row.module.title}"/></h2></div><a data-form-modal class="button button-small" href="${ctx}/gestion/modulos/${row.module.id}/contenidos/nuevo">+ Contenido</a></div><c:forEach items="${row.contents}" var="content"><div class="syllabus-item"><span class="lesson-icon">▤</span><div><strong><c:out value="${content.title}"/></strong><small>${content.type} · Orden ${content.position} ${content.preview ? '· Vista previa' : ''}</small></div><div class="row-actions"><a data-form-modal class="text-link" href="${ctx}/gestion/contenidos/${content.id}/editar">Editar</a><c:if test="${content.type == 'EVALUACION'}"><a class="text-link" href="${ctx}/gestion/contenidos/${content.id}/preguntas">Preguntas</a></c:if><form action="${ctx}/gestion/contenidos/${content.id}/eliminar" method="post" data-confirm="¿Eliminar este contenido sin historial académico?"><%@ include file="../fragments/csrf.jspf" %><button class="link-button danger">Eliminar</button></form></div></div></c:forEach>
<div class="actions section-space"><button type="button" class="button button-ghost" data-modal-source="#module-edit-${row.module.id}" data-modal-title="Editar módulo">Editar módulo</button><form action="${ctx}/gestion/modulos/${row.module.id}/eliminar" method="post" data-confirm="¿Eliminar este módulo vacío?"><%@ include file="../fragments/csrf.jspf" %><input type="hidden" name="courseId" value="${course.id}"/><button class="link-button danger">Eliminar módulo vacío</button></form></div>
<template id="module-edit-${row.module.id}"><form action="${ctx}/gestion/cursos/${course.id}/modulos" method="post" class="stack-form"><%@ include file="../fragments/csrf.jspf" %><input type="hidden" name="moduleId" value="${row.module.id}"/><label>Nombre del módulo<input name="title" value="<c:out value='${row.module.title}'/>" maxlength="180" required/></label><label>Orden<input type="number" name="position" value="${row.module.position}" min="1" max="999" required/></label><div class="actions"><button class="button">Guardar módulo</button><button type="button" class="button button-ghost" data-modal-close>Cancelar</button></div></form></template></section></c:forEach>
<div class="section-space"><button type="button" class="button" data-modal-source="#module-new" data-modal-title="Agregar módulo">+ Agregar módulo</button></div><template id="module-new"><form action="${ctx}/gestion/cursos/${course.id}/modulos" method="post" class="stack-form"><%@ include file="../fragments/csrf.jspf" %><label>Nombre del módulo<input name="title" maxlength="180" required/></label><label>Orden<input name="position" type="number" min="1" max="999" value="${fn:length(syllabus)+1}" required/></label><div class="actions"><button class="button">Guardar módulo</button><button type="button" class="button button-ghost" data-modal-close>Cancelar</button></div></form></template><c:if test="${role == 'ADMIN'}"><section class="panel section-space"><h3>Eliminar un curso sin registros</h3><p class="muted small">Solo puede eliminarse un curso vacío y sin relaciones académicas o comerciales. Un curso con historial puede ocultarse del catálogo desde su edición.</p><form action="${ctx}/admin/cursos/${course.id}/eliminar" method="post" data-confirm="¿Eliminar definitivamente este curso vacío?"><%@ include file="../fragments/csrf.jspf" %><button class="button button-danger">Eliminar curso</button></form></section></c:if>
<%@ include file="../fragments/footer.jspf" %>
