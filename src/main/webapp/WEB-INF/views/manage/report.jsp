<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<a class="back-link" href="${ctx}/gestion/cursos/${course.id}">← Gestión del curso</a><div class="page-heading with-action"><div><span class="eyebrow">ACOMPAÑAMIENTO CON EVIDENCIAS</span><h1>Seguimiento académico</h1><p><c:out value="${course.title}"/></p></div><a class="button button-ghost" href="${ctx}/gestion/cursos/${course.id}/reporte.csv">Exportar seguimiento ↓</a></div>
<section class="panel"><h2>Estudiantes y progreso</h2><div class="table-wrap"><table><thead><tr><th>Participante</th><th>Correo</th><th>Progreso</th><th>Vigencia</th></tr></thead><tbody><c:forEach items="${roster}" var="row"><tr><td><div class="person-cell"><span class="avatar"><c:out value="${row.student.initials}"/></span><strong><c:out value="${row.student.fullName}"/></strong></div></td><td><c:out value="${row.student.email}"/></td><td><progress max="100" value="${row.percent}"></progress><small>${row.percent}%</small></td><td><span class="badge ${row.enrollment.current ? 'positive' : 'warning'}">${row.enrollment.current ? 'VIGENTE' : 'NO VIGENTE'}</span></td></tr></c:forEach></tbody></table></div><c:if test="${empty roster}"><p class="muted">El curso aún no tiene estudiantes matriculados.</p></c:if></section>
<section class="panel section-space"><h2>Actividades y calificaciones</h2><div class="table-wrap"><table><thead><tr><th>Estudiante / actividad</th><th>Entrega</th><th>Calificación</th></tr></thead><tbody><c:forEach items="${submissions}" var="s"><tr><td><strong><c:out value="${s.student.fullName}"/></strong><small><c:out value="${s.content.title}"/> · Intento ${s.attemptNumber}</small></td><td><a class="text-link" href="${ctx}/entregas/${s.id}/archivo"><c:out value="${s.fileName}"/> ↓</a><small><c:out value="${s.comment}"/></small></td><td><p>${s.grade == null ? 'Por calificar' : s.grade}</p><button type="button" class="button button-small" data-modal-source="#grade-${s.id}" data-modal-title="Calificar actividad">${s.grade == null ? 'Calificar' : 'Editar nota'}</button><template id="grade-${s.id}"><form action="${ctx}/gestion/entregas/${s.id}/calificar" method="post" class="grade-form"><%@ include file="../fragments/csrf.jspf" %><label>Nota sobre 20<input type="number" name="grade" min="0" max="20" step="0.01" value="${s.grade}" required/></label><label>Retroalimentación<textarea name="feedback" maxlength="1000" rows="2"><c:out value="${s.feedback}"/></textarea></label><button class="button button-small">Guardar nota</button></form></template></td></tr></c:forEach></tbody></table></div><c:if test="${empty submissions}"><p class="muted">Aún no se han entregado actividades.</p></c:if></section>
<section class="panel section-space"><h2>Resultados de evaluaciones</h2><div class="table-wrap"><table><thead><tr><th>Estudiante</th><th>Evaluación</th><th>Intento</th><th>Resultado</th><th>Estado</th><th>Detalle</th></tr></thead><tbody><c:forEach items="${attempts}" var="a"><tr><td><c:out value="${a.student.fullName}"/></td><td><c:out value="${a.content.title}"/></td><td>${a.attemptNumber}</td><td>${a.percent}% · ${a.stars} ★</td><td><span class="badge ${a.passed ? 'positive' : 'warning'}">${a.passed ? 'APROBADO' : 'NO APROBADO'}</span></td><td><a class="text-link" href="${ctx}/evaluaciones/intentos/${a.id}">Ver →</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty attempts}"><p class="muted">Aún no hay evaluaciones resueltas.</p></c:if></section>
<%@ include file="../fragments/footer.jspf" %>
