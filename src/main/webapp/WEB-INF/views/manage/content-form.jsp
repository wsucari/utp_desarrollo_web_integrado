<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<a class="back-link" href="${ctx}/gestion/cursos/${module.course.id}">← <c:out value="${module.course.title}"/></a><div class="page-heading"><span class="eyebrow"><c:out value="${module.title}"/></span><h1>${id == null ? 'Nuevo contenido' : 'Editar contenido'}</h1><p>Organiza recursos, actividades y espacios de participación.</p></div>
<section class="panel form-panel"><form:form modelAttribute="form" method="post" action="${ctx}/gestion/modulos/${module.id}/contenidos" cssClass="stack-form"><form:errors path="*" cssClass="form-errors" element="div"/><c:if test="${id != null}"><input type="hidden" name="id" value="${id}"/></c:if><label>Título<form:input path="title" maxlength="180" required="required"/></label><div class="form-grid"><label>Tipo de contenido<form:select path="type" items="${types}"/></label><label>Orden<form:input path="position" type="number" min="1" max="999" required="required"/></label></div><label>Contenido o instrucciones<form:textarea path="body" rows="9" maxlength="12000"/></label><label>Recurso externo HTTPS (opcional)<form:input path="resourceUrl" type="url" maxlength="1000" placeholder="https://..."/></label><small>Los videos de YouTube se muestran en el aula. Otros recursos se abren mediante su enlace.</small><div class="form-grid"><label>Máximo de intentos o entregas<form:input path="maxAttempts" type="number" min="0" max="20" required="required"/></label><label>Porcentaje de aprobación de evaluación<form:input path="passPercent" type="number" min="0" max="100" required="required"/></label></div><small>Evaluaciones: de 1 a 20 intentos; 0 permite intentos sin límite. Actividades: de 1 a 10 entregas.</small><label class="checkbox-label"><form:checkbox path="examActive"/>Evaluación activa (solo para contenidos de evaluación)</label><label class="checkbox-label"><form:checkbox path="preview"/>Permitir vista previa del texto o video sin matrícula</label><button class="button">Guardar contenido</button></form:form></section>
<c:if test="${id != null}"><section class="panel form-panel section-space"><h2>Adjuntar material</h2><p class="muted">El archivo se almacena de forma privada y solo se descarga con autorización.</p><form action="${ctx}/gestion/contenidos/${id}/material" method="post" enctype="multipart/form-data" class="stack-form"><%@ include file="../fragments/csrf.jspf" %><label>Archivo de hasta 10 MB<input name="file" type="file" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg,.zip" required/></label><button class="button button-ghost">Subir material ↑</button></form></section></c:if>
<%@ include file="../fragments/footer.jspf" %>
