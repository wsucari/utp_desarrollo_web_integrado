<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<div class="page-heading"><span class="eyebrow">ACCESO ACADÉMICO</span><h1>Matrículas y vigencia</h1><p>El vencimiento o la cancelación del acceso no elimina el historial del estudiante.</p></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Estudiante</th><th>Curso</th><th>Inicio</th><th>Acceso hasta</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach items="${enrollments}" var="e"><tr><td><c:out value="${e.student.fullName}"/></td><td><c:out value="${e.course.title}"/></td><td>${e.startsAt.toLocalDate()}</td><td>${e.expiresAt.toLocalDate()}</td><td><span class="badge ${e.current ? 'positive' : 'warning'}">${e.current ? 'VIGENTE' : e.status == 'CANCELADA' ? 'CANCELADA' : 'NO VIGENTE'}</span></td><td><c:if test="${e.status == 'ACTIVA'}"><form action="${ctx}/admin/matriculas/${e.id}/cancelar" method="post" data-confirm="¿Cancelar el acceso de esta matrícula?"><%@ include file="../fragments/csrf.jspf" %><button class="link-button danger">Cancelar acceso</button></form></c:if></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="../fragments/footer.jspf" %>
