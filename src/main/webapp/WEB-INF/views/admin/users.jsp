<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<div class="page-heading with-action"><div><h1><c:out value="${pageTitle}"/></h1></div><a data-form-modal class="button" href="${ctx}/admin/usuarios/nuevo${path == '/admin/profesores' ? '?initialRole=DOCENTE' : ''}">+ ${path == '/admin/profesores' ? 'Nuevo profesor' : 'Nuevo usuario'}</a></div><section class="panel"><label class="search-field table-search"><svg><use href="#i-search"/></svg><input data-table-filter="users-table" placeholder="Buscar por nombre, correo o rol..." aria-label="Buscar usuario"/></label><div class="table-wrap"><table id="users-table"><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Especialidad</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${accounts}" var="account"><tr><td><div class="person-cell"><span class="avatar"><c:out value="${account.initials}"/></span><strong><c:out value="${account.fullName}"/></strong></div></td><td><c:out value="${account.email}"/></td><td><span class="badge">${account.role}</span></td><td><c:out value="${account.professionalTitle}"/></td><td><span class="badge ${account.active ? 'positive' : 'warning'}">${account.active ? 'ACTIVO' : 'INACTIVO'}</span></td><td><a data-form-modal class="text-link" href="${ctx}/admin/usuarios/${account.id}/editar">Editar →</a></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="../fragments/footer.jspf" %>
