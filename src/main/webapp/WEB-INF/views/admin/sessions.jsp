<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<h1 class="tw-text-2xl tw-font-semibold">Sesiones</h1><form method="get" action="${ctx}/admin/sesiones" class="tw-flex tw-flex-wrap tw-gap-3 tw-my-6"><input name="search" value="<c:out value='${search}'/>" placeholder="Buscar por nombre o correo" aria-label="Buscar sesiones"/><select name="sesion" aria-label="Estado de sesión"><option value="">Todas las sesiones</option><option value="en sesion" ${sesion == 'en sesion' ? 'selected' : ''}>En sesión</option><option value="sesion terminada" ${sesion == 'sesion terminada' ? 'selected' : ''}>Sesión terminada</option></select><button class="button">Buscar</button></form><section class="tw-bg-white tw-rounded-lg tw-shadow tw-p-5"><div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Inicio de sesión</th><th>Fin de sesión</th><th>Duración</th><th>Rol</th><th>Estado</th></tr></thead><tbody><c:forEach items="${sessions}" var="record"><tr><td><c:out value="${record.account.fullName}"/></td><td><c:out value="${record.account.email}"/></td><td><c:out value="${record.loggedInAt}"/></td><td><c:out value="${record.loggedOutAt}"/></td><td><c:out value="${record.duration}"/></td><td><c:out value="${record.roleAtLogin}"/></td><td>${record.current ? 'En sesión' : 'Sesión terminada'}</td></tr></c:forEach></tbody></table></div><c:if test="${empty sessions}"><p>No hay sesiones registradas.</p></c:if></section>
<%@ include file="../fragments/footer.jspf" %>
