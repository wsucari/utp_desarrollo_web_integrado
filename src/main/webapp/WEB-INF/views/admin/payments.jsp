<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<div class="page-heading with-action"><div><h1>Pagos</h1><p>Registro administrativo de pagos y vigencia de matrículas.</p></div><a href="${ctx}/admin/pagos/nuevo" data-form-modal class="button">+ Registrar pago</a></div>
<section class="panel"><label class="search-field table-search"><svg><use href="#i-search"/></svg><input data-table-filter="payments-table" placeholder="Buscar estudiante, curso o referencia" aria-label="Buscar pagos"/></label>
<div class="table-wrap"><table id="payments-table"><thead><tr><th>Estudiante / curso</th><th>Importe</th><th>Referencia</th><th>Estado</th><th>Acceso hasta</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${payments}" var="p"><tr><td><strong><c:out value="${p.student.fullName}"/></strong><small><c:out value="${p.course.title}"/></small></td><td>S/ <fmt:formatNumber value="${p.amount}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:out value="${p.reference}"/><small><c:out value="${p.createdAt.toLocalDate()}"/></small></td><td><span class="badge ${p.status == 'CONFIRMADO' ? 'positive' : p.status == 'PENDIENTE' ? 'warning' : ''}"><c:out value="${p.status}"/></span></td><td><c:out value="${paymentDates[p.id]}"/></td><td><a data-form-modal class="text-link" href="${ctx}/admin/pagos/${p.id}/editar">Editar</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty payments}"><p class="muted">No hay pagos registrados.</p></c:if></section>
<%@ include file="../fragments/footer.jspf" %>
