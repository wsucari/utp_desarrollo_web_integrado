<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/start.jspf" %><%@ include file="../fragments/header.jspf" %>
<h1 class="tw-text-2xl tw-font-semibold">Ver como</h1><form method="get" action="${ctx}/admin/vista-previa" class="tw-flex tw-flex-wrap tw-gap-3 tw-my-6"><input name="search" value="<c:out value='${search}'/>" placeholder="Buscar por nombre o correo" aria-label="Buscar usuario"/><select name="roleFilter" aria-label="Perfil"><option value="">Todos</option><option value="ESTUDIANTE" ${roleFilter == 'ESTUDIANTE' ? 'selected' : ''}>Estudiantes</option><option value="DOCENTE" ${roleFilter == 'DOCENTE' ? 'selected' : ''}>Profesores</option></select><button class="button">Buscar</button></form>
<div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-3 tw-gap-4"><c:forEach items="${accounts}" var="account"><article class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-p-5"><span class="avatar"><c:out value="${account.initials}"/></span><h2 class="tw-text-lg tw-mt-3"><c:out value="${account.fullName}"/></h2><p class="tw-text-gray-500"><c:out value="${account.email}"/></p><p>${account.role == 'DOCENTE' ? 'Profesor' : 'Estudiante'}</p><a class="button button-small" href="${ctx}/admin/vista-previa/${account.role == 'DOCENTE' ? 'profesor' : 'estudiante'}/${account.id}">Ver como</a></article></c:forEach></div>
<%@ include file="../fragments/footer.jspf" %>
