<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<a class="back-link" href="${ctx}${role == 'ESTUDIANTE' ? '/mis-cursos' : '/gestion/cursos'}">← ${role == 'ESTUDIANTE' ? 'Cursos Inscritos' : 'Cursos'}</a><div class="page-heading"><h1><c:out value="${course.title}"/></h1><p><c:out value="${course.teacherNames}"/> · ${course.durationHours} horas</p></div>
<div class="two-column"><section class="panel"><h2>Contenido del curso</h2><c:forEach items="${syllabus}" var="row"><div class="syllabus-module"><h3>${row.module.position}. <c:out value="${row.module.title}"/></h3><c:forEach items="${row.contents}" var="lesson"><a class="syllabus-item syllabus-link" href="${ctx}/contenidos/${lesson.id}"><span class="lesson-icon ${completed.contains(lesson.id) ? 'done' : ''}">${completed.contains(lesson.id) ? '✓' : lesson.type == 'VIDEO' ? '▷' : '▤'}</span><div><strong><c:out value="${lesson.title}"/></strong><small>${lesson.type}</small></div><span class="text-link">Abrir →</span></a></c:forEach></div></c:forEach></section><aside class="panel"><span class="stat-icon mint"><svg><use href="#i-chart"/></svg></span><h2>${canManage ? 'Vista del aula' : 'Cada paso cuenta'}</h2><c:if test="${!canManage}"><div class="progress-label"><span>Tu progreso</span><strong>${percent}%</strong></div><progress max="100" value="${percent}"></progress><p class="muted">Completa las lecciones, entrega tu actividad, participa en el foro y aprueba la evaluación para avanzar.</p><a class="text-link" href="${ctx}/certificados">Ver mis logros ↗</a></c:if><c:if test="${canManage}"><p class="muted">Consulta los contenidos tal como los ve el estudiante.</p><a class="button" href="${ctx}/gestion/cursos/${course.id}">Gestionar contenidos</a></c:if></aside></div>
<%@ include file="fragments/footer.jspf" %>
