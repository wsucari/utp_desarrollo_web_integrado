<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<a class="back-link" href="${ctx}/">← Programas formativos</a>
<div class="course-detail-grid"><div><div class="course-detail-hero tone-${course.id % 3}"><span class="pill"><c:out value="${course.category}"/></span><h1><c:out value="${course.title}"/></h1><p>${course.durationHours} horas · <c:out value="${course.level}"/> · Formación en línea</p><span class="detail-orbit"></span></div><section class="panel section-space"><h2>Descripción del curso</h2><p class="preserve-lines"><c:out value="${course.description}"/></p><h3>Objetivos de aprendizaje</h3><p class="preserve-lines"><c:out value="${course.objectives}"/></p><h3>Equipo docente</h3><p><c:out value="${empty course.teacherNames ? 'Sin asignación docente' : course.teacherNames}"/></p></section>
<section class="panel"><div class="section-heading"><div><h2>Contenido del curso</h2></div></div><c:forEach items="${syllabus}" var="row"><div class="syllabus-module"><h3>${row.module.position}. <c:out value="${row.module.title}"/></h3><c:forEach items="${row.contents}" var="lesson"><div class="syllabus-item"><span class="lesson-icon">${lesson.type == 'VIDEO' ? '▷' : lesson.type == 'EVALUACION' ? '✓' : lesson.type == 'FORO' ? '◇' : '▤'}</span><div><strong><c:out value="${lesson.title}"/></strong><small>${lesson.type}</small></div><c:choose><c:when test="${canLearn}"><a class="text-link" href="${ctx}/contenidos/${lesson.id}">Abrir →</a></c:when><c:when test="${lesson.preview}"><a class="text-link" href="${ctx}/vista-previa/${lesson.id}">Vista previa →</a></c:when><c:otherwise><span class="muted">Con matrícula</span></c:otherwise></c:choose></div></c:forEach></div></c:forEach><c:if test="${empty syllabus}"><p class="muted">El programa aún no tiene contenidos publicados.</p></c:if></section></div>
<aside class="panel course-purchase"><span class="eyebrow">INVERSIÓN EN TU FORMACIÓN</span><div class="course-price">S/ <fmt:formatNumber value="${course.price}" minFractionDigits="2"/></div><p class="muted">Acceso sujeto a validación administrativa de la matrícula.</p><c:choose><c:when test="${canLearn}"><a class="button button-full" href="${ctx}/aula/cursos/${course.id}">Ir al aula →</a></c:when><c:when test="${role == 'ESTUDIANTE'}"><form method="post" action="${ctx}/carrito/${course.id}"><%@ include file="fragments/csrf.jspf" %><button class="button button-full">Agregar a mi selección</button></form></c:when><c:when test="${user == null}"><a class="button button-full" href="${ctx}/login">Ingresar para inscribirme</a></c:when><c:otherwise><p>Tu perfil de gestión no realiza compras.</p></c:otherwise></c:choose><ul class="feature-list"><li>✓ ${course.durationHours} horas de formación</li><li>✓ Materiales y actividades</li><li>✓ Evaluaciones formativas</li><li>✓ Participación académica</li><c:if test="${course.certificateEnabled}"><li>✓ Certificado al completar el curso</li></c:if></ul><div class="soft-note">Tu aprendizaje, en un solo lugar.</div></aside></div>
<section class="panel section-space" id="resenas"><span class="eyebrow">COMUNIDAD ACADÉMICA</span><h2>Experiencias del curso</h2><c:forEach items="${reviews}" var="review"><article class="review"><strong><c:out value="${review.author.fullName}"/></strong><span class="badge">★ ${review.score}/5</span><p><c:out value="${review.body}"/></p><c:if test="${user.id == review.author.id || role == 'ADMIN'}"><form action="${ctx}/resenas/${review.id}/eliminar" method="post"><%@ include file="fragments/csrf.jspf" %><input type="hidden" name="courseId" value="${course.id}"/><button class="link-button danger">Retirar reseña</button></form></c:if></article></c:forEach><c:if test="${empty reviews}"><p class="muted">Aún no se han compartido experiencias.</p></c:if><c:if test="${role == 'ESTUDIANTE' && canLearn}"><form action="${ctx}/cursos/${course.id}/resenas" method="post" class="stack-form"><%@ include file="fragments/csrf.jspf" %><label>Tu valoración<select name="score"><c:forEach begin="1" end="5" var="n"><option value="${n}">${n} de 5</option></c:forEach></select></label><label>Comparte tu experiencia<textarea name="body" maxlength="2000" required></textarea></label><button class="button">Guardar mi reseña</button></form></c:if></section>
<%@ include file="fragments/footer.jspf" %>
