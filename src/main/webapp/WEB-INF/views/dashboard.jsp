<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<c:choose><c:when test="${role == 'ADMIN'}">
<h1 class="tw-text-3xl tw-font-bold tw-text-gray-800 tw-mb-8">Panel de Administración</h1>
<div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-6">
<div class="tw-bg-white tw-p-6 tw-rounded-lg tw-shadow-lg"><h2 class="tw-text-2xl tw-font-semibold">Cursos</h2><p class="tw-text-gray-500">Total cursos</p><strong class="tw-block tw-mt-6 tw-text-4xl tw-text-blue-500">${courseCount}</strong></div>
<div class="tw-bg-white tw-p-6 tw-rounded-lg tw-shadow-lg"><h2 class="tw-text-2xl tw-font-semibold">Profesores</h2><p class="tw-text-gray-500">Registrados</p><strong class="tw-block tw-mt-6 tw-text-4xl tw-text-green-500">${teacherCount}</strong></div>
<div class="tw-bg-white tw-p-6 tw-rounded-lg tw-shadow-lg"><h2 class="tw-text-2xl tw-font-semibold">Usuarios</h2><p class="tw-text-gray-500">Total activos</p><strong class="tw-block tw-mt-6 tw-text-4xl tw-text-yellow-500">${users}</strong></div>
<div class="tw-bg-white tw-p-6 tw-rounded-lg tw-shadow-lg"><h2 class="tw-text-2xl tw-font-semibold">Pagos</h2><p class="tw-text-gray-500">${paymentCount} Realizados</p><strong class="tw-block tw-mt-6 tw-text-3xl tw-text-red-500">S/. <fmt:formatNumber value="${paymentTotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></div>
</div>
<section class="tw-mt-12"><h2 class="tw-text-2xl tw-font-semibold tw-text-gray-700 tw-mb-4">Detalle de Cursos Registrados</h2><div class="table-wrap tw-bg-white tw-rounded-lg tw-shadow-lg"><table><thead><tr><th>#</th><th>Curso</th><th>Profesor</th><th>Usuarios inscritos</th><th>Total Pagado</th><th>Certificados Emitidos</th><th>Reseñas</th><th>Estado</th></tr></thead><tbody><c:forEach items="${courseRows}" var="row"><tr><td>${row.course.id}</td><td><a href="${ctx}/gestion/cursos/${row.course.id}"><c:out value="${row.course.title}"/></a></td><td><c:out value="${row.course.teacherNames}"/></td><td>${row.enrollments}</td><td>S/. <fmt:formatNumber value="${row.payments}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${row.certificates}</td><td>${row.comments}</td><td>${row.course.published ? 'Publicado' : 'Borrador'}</td></tr></c:forEach></tbody></table></div></section>
</c:when><c:when test="${role == 'DOCENTE'}">
<h1 class="tw-text-2xl tw-font-semibold">Menú principal</h1><div class="tw-mt-6 tw-grid tw-grid-cols-1 md:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4"><div class="tw-p-4 tw-bg-white tw-shadow-lg tw-rounded-lg tw-flex tw-items-center tw-gap-4"><svg class="tw-text-blue-500"><use href="#i-book"/></svg><div><p class="tw-text-xl tw-font-semibold tw-mb-0">${courseCount}</p><p class="tw-text-gray-600 tw-mb-0">Cursos asignados</p></div></div></div>
<section class="tw-mt-8"><h2 class="tw-text-3xl tw-font-bold tw-text-gray-900 tw-mb-6">Cursos asignados</h2><div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-3 xl:tw-grid-cols-4 tw-gap-6"><c:forEach items="${courses}" var="course"><article class="tw-p-4 tw-bg-white tw-rounded-xl tw-shadow-lg"><img src="${ctx}/images/logos/inudiblack.png" alt="<c:out value='${course.title}'/>" class="tw-w-full tw-aspect-video tw-object-cover tw-rounded-xl tw-bg-gray-100"/><h3 class="tw-text-xl tw-font-semibold tw-text-gray-800 tw-mt-4"><c:out value="${course.title}"/></h3><div class="tw-grid tw-gap-2 tw-mt-4"><a href="${ctx}/cursos/${course.id}" class="tw-bg-slate-700 tw-text-gray-100 tw-p-2 tw-text-center tw-rounded-lg">Ver curso</a><a href="${ctx}/gestion/cursos/${course.id}" class="tw-bg-blue-500 tw-text-gray-100 tw-p-2 tw-text-center tw-rounded-lg">Gestionar contenido</a></div></article></c:forEach></div></section>
</c:when><c:otherwise>
<h1 class="tw-text-2xl tw-font-semibold">Inicio</h1><section class="tw-bg-white tw-rounded-xl tw-border tw-border-gray-200 tw-p-6 tw-mt-6"><div class="tw-flex tw-flex-wrap tw-items-center tw-justify-between tw-gap-4"><div><h2 class="tw-text-2xl tw-font-semibold">Hola, <c:out value="${user.fullName}"/></h2><p class="tw-text-gray-600">Tienes ${activeCount} cursos activos y ${totalStars} estrellas acumuladas por tu avance.</p></div><div class="tw-flex tw-flex-wrap tw-gap-3"><a href="${ctx}/users/panel/inscritos" class="tw-bg-green-700 tw-text-white tw-px-4 tw-py-2 tw-rounded-lg">Ver mis cursos</a><a href="${ctx}/" class="tw-border tw-border-gray-300 tw-px-4 tw-py-2 tw-rounded-lg">Explorar cursos</a></div></div></section>
<div class="tw-grid tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4 tw-my-6"><div class="tw-bg-white tw-rounded-lg tw-p-4"><p class="tw-text-gray-500">Cursos inscritos</p><strong class="tw-text-2xl">${courseCount}</strong></div><div class="tw-bg-white tw-rounded-lg tw-p-4"><p class="tw-text-gray-500">Cursos activos</p><strong class="tw-text-2xl">${activeCount}</strong></div><div class="tw-bg-white tw-rounded-lg tw-p-4"><p class="tw-text-gray-500">Completados</p><strong class="tw-text-2xl">${completedCount}</strong></div><div class="tw-bg-white tw-rounded-lg tw-p-4"><p class="tw-text-gray-500">Certificados</p><strong class="tw-text-2xl">${certificateCount}</strong></div></div>
<h2 class="tw-text-2xl tw-font-semibold">Mis cursos</h2><%@ include file="fragments/enrolled-courses.jspf" %>
</c:otherwise></c:choose>
<%@ include file="fragments/footer.jspf" %>
