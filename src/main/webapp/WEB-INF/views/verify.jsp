<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<div class="narrow"><div class="page-heading"><span class="eyebrow">CONFIRMA UN LOGRO ACADÉMICO</span><h1>Validación de certificados</h1><p>Ingresa el código de siete dígitos que figura en el certificado.</p></div><form method="get" action="${ctx}/cert" class="filter-bar"><input name="codigo" pattern="[0-9]{7}" minlength="7" maxlength="7" placeholder="Código de 7 dígitos" aria-label="Código del certificado" required/><button class="button">Verificar →</button></form>
<c:if test="${searched}"><c:choose><c:when test="${certificate != null}"><section class="panel verified-card"><span class="stat-icon mint"><svg><use href="#i-check"/></svg></span><span class="eyebrow">REGISTRO ENCONTRADO</span><h2>Certificado válido</h2><dl><dt>Participante</dt><dd><c:out value="${certificate.studentName}"/></dd><dt>Programa</dt><dd><c:out value="${certificate.courseTitle}"/></dd><dt>Código</dt><dd>${certificate.code}</dd><dt>Fecha de emisión</dt><dd>${certificate.issuedAt.toLocalDate()}</dd><dt>Institución</dt><dd>Inudi Perú</dd></dl><c:if test="${demo}"><div class="soft-note">Registro de demostración local. No acredita una certificación institucional real.</div></c:if></section></c:when><c:otherwise><div class="alert error">No se encontró un certificado con ese código.</div></c:otherwise></c:choose></c:if></div>
<%@ include file="fragments/footer.jspf" %>
