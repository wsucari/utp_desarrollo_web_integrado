<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<div class="page-heading"><h1>Certificados</h1><p>Completa tu ruta de aprendizaje y obtén un certificado verificable.</p></div>
<div class="learning-grid"><c:forEach items="${certificates}" var="cert"><article class="panel certificate-card"><span class="stat-icon sand"><svg><use href="#i-award"/></svg></span><span class="eyebrow">CERTIFICADO EMITIDO</span><h2><c:out value="${cert.courseTitle}"/></h2><p><c:out value="${cert.studentName}"/></p><span class="badge positive">Código ${cert.code}</span><p class="muted small">Emitido el ${cert.issuedAt.toLocalDate()}</p><div class="actions"><a class="button button-small" href="${ctx}/certificados/${cert.id}/pdf">Descargar PDF ↓</a><a class="text-link" href="${ctx}/cert/${cert.code}">Validar ↗</a></div></article></c:forEach></div><c:if test="${empty certificates}"><div class="empty-state"><svg><use href="#i-award"/></svg><h2>No hay certificados emitidos</h2><p>Los certificados se habilitan al completar el 100 % de un curso con certificación y matrícula vigente.</p></div></c:if>
<section class="panel section-space"><h2>Tu avance hacia el certificado</h2><c:forEach items="${myCourses}" var="row"><c:if test="${row.course.certificateEnabled}"><div class="certificate-progress"><div><h3><c:out value="${row.course.title}"/></h3><progress max="100" value="${row.percent}"></progress><small>${row.percent}% completado</small></div><c:if test="${row.percent == 100 && row.enrollment.current}"><form action="${ctx}/certificados/emitir/${row.course.id}" method="post"><%@ include file="fragments/csrf.jspf" %><button class="button">Obtener certificado</button></form></c:if></div></c:if></c:forEach></section>
<%@ include file="fragments/footer.jspf" %>
