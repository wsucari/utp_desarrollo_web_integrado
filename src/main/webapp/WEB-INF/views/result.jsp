<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<a class="back-link" href="${ctx}/contenidos/${attempt.content.id}">← Volver a la evaluación</a><section class="result-hero panel"><span class="eyebrow">EVALUACIÓN FORMATIVA · INTENTO ${attempt.attemptNumber}</span><div class="result-score">${attempt.percent}<span>%</span></div><h1>${attempt.passed ? '¡Un paso más en tu aprendizaje!' : 'Cada intento es una oportunidad'}</h1><p><c:out value="${attempt.content.title}"/> · <c:out value="${attempt.student.fullName}"/></p><span class="badge ${attempt.passed ? 'positive' : 'warning'}">${attempt.passed ? 'APROBADO' : 'NO APROBADO'}</span><div class="stars"><c:forEach begin="1" end="${attempt.stars}">★</c:forEach></div><c:if test="${attempt.passed && role == 'ESTUDIANTE'}"><form action="${ctx}/contenidos/${attempt.content.id}/completar" method="post"><%@ include file="fragments/csrf.jspf" %><button class="button">Registrar contenido completado ✓</button></form></c:if></section><section class="panel section-space"><h2>Revisa tus respuestas</h2><c:forEach items="${answers}" var="answer" varStatus="n"><article class="answer-review"><div class="section-heading compact"><h3>${n.count}. <c:out value="${answer.question.prompt}"/></h3><span class="badge ${answer.correct ? 'positive' : 'warning'}">${answer.earnedPoints}/${answer.question.points} puntos</span></div><p><strong>Tu respuesta:</strong> <c:out value="${answer.answerText}"/></p><p><strong>Respuesta esperada:</strong> <c:out value="${answer.question.correctAnswer}"/></p><p class="muted"><c:out value="${answer.question.explanation}"/></p></article></c:forEach></section>
<%@ include file="fragments/footer.jspf" %>
