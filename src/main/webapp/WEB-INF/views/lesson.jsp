<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/start.jspf" %><%@ include file="fragments/header.jspf" %>
<a class="back-link" href="${ctx}${canLearn ? '/aula/cursos/' : '/catalogo/'}${course.id}">← <c:out value="${course.title}"/></a>
<div class="lesson-layout"><div class="lesson-main"><div class="page-heading"><span class="eyebrow">${content.type} · <c:out value="${content.module.title}"/></span><h1><c:out value="${content.title}"/></h1></div><section class="panel">
<c:if test="${content.type == 'VIDEO'}"><c:choose><c:when test="${not empty embedUrl}"><iframe class="video-frame" src="<c:out value='${embedUrl}'/>" title="Recurso audiovisual del curso" allowfullscreen></iframe></c:when><c:otherwise><div class="video-placeholder"><span>▷</span><strong>Recurso audiovisual</strong><small>${empty content.resourceUrl ? 'El docente aún no ha vinculado un video.' : 'El video está disponible en el enlace del recurso.'}</small></div></c:otherwise></c:choose></c:if>
<div class="lesson-body preserve-lines"><c:out value="${content.body}"/></div>
<c:if test="${not empty content.resourceUrl}"><a class="button button-ghost" href="<c:out value='${content.resourceUrl}'/>" target="_blank" rel="noopener noreferrer">Abrir recurso externo ↗</a></c:if>
<c:if test="${not empty content.fileKey && canLearn}"><a class="button button-ghost" href="${ctx}/contenidos/${content.id}/archivo">Descargar <c:out value="${content.fileName}"/> ↓</a></c:if>
<c:if test="${!canLearn}"><div class="soft-note">Estás viendo un contenido de acceso previo. Una matrícula vigente habilita la participación y el registro de tu progreso.</div></c:if>
<c:if test="${role == 'ESTUDIANTE' && canLearn}"><div class="completion-action"><c:choose><c:when test="${completed.contains(content.id)}"><span class="badge positive">✓ Contenido completado</span></c:when><c:otherwise><form action="${ctx}/contenidos/${content.id}/completar" method="post"><%@ include file="fragments/csrf.jspf" %><button class="button">Marcar como completado ✓</button></form></c:otherwise></c:choose></div></c:if>
<c:if test="${canManage}"><div class="actions section-space"><a data-form-modal class="button button-ghost" href="${ctx}/gestion/contenidos/${content.id}/editar">Editar contenido</a><c:if test="${content.type == 'EVALUACION'}"><a class="button" href="${ctx}/gestion/contenidos/${content.id}/preguntas">Gestionar preguntas</a></c:if></div></c:if></section>
<c:if test="${content.type == 'ACTIVIDAD' && canLearn}"><section class="panel section-space"><span class="eyebrow">APLICA LO APRENDIDO</span><h2>Entrega de actividad</h2><p class="muted">Hasta ${content.maxAttempts} entregas. Nota de 0 a 20. Tamaño máximo: 10 MB.</p><c:if test="${role == 'ESTUDIANTE' && fn:length(submissions) < content.maxAttempts}"><button type="button" class="button" data-modal-source="#submission-new" data-modal-title="Enviar actividad">Enviar actividad</button><template id="submission-new"><form action="${ctx}/contenidos/${content.id}/entregar" method="post" enctype="multipart/form-data" class="stack-form"><%@ include file="fragments/csrf.jspf" %><label>Archivo de tu actividad<input type="file" name="file" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg,.zip" required/></label><small>PDF, documentos de Office, TXT, imágenes o ZIP.</small><label>Comentario para el docente<textarea name="comment" maxlength="1000" placeholder="Comparte el contexto de tu entrega."></textarea></label><button class="button">Enviar actividad ↑</button></form></template></c:if><div class="table-wrap section-space"><table><thead><tr><th>Participante</th><th>Intento</th><th>Archivo</th><th>Nota</th><th>Retroalimentación</th></tr></thead><tbody><c:forEach items="${submissions}" var="s"><tr><td><c:out value="${s.student.fullName}"/></td><td>${s.attemptNumber}</td><td><a class="text-link" href="${ctx}/entregas/${s.id}/archivo"><c:out value="${s.fileName}"/> ↓</a><small><c:out value="${s.comment}"/></small></td><td>${s.grade == null ? 'Por calificar' : s.grade}</td><td><c:out value="${s.feedback}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty submissions}"><p class="muted">Aún no hay entregas registradas.</p></c:if><c:if test="${canManage}"><a class="text-link" href="${ctx}/gestion/cursos/${course.id}/seguimiento">Calificar desde seguimiento académico →</a></c:if></section></c:if>
<c:if test="${content.type == 'EVALUACION' && canLearn}"><section class="panel section-space"><span class="eyebrow">APRENDE CON CADA INTENTO</span><h2>Evaluación formativa</h2><p class="muted">Aprobación: ${content.passPercent}% · ${content.maxAttempts == 0 ? 'Intentos sin límite.' : 'Máximo '}<c:if test="${content.maxAttempts > 0}">${content.maxAttempts} intentos.</c:if></p><c:if test="${role == 'ESTUDIANTE' && content.examActive && (content.maxAttempts == 0 || fn:length(attempts) < content.maxAttempts) && not empty questions}">
<form action="${ctx}/contenidos/${content.id}/evaluar" method="post" class="exam-form"><%@ include file="fragments/csrf.jspf" %><c:forEach items="${questions}" var="q" varStatus="number"><fieldset class="question"><legend><span class="question-number">${number.count}</span><c:out value="${q.prompt}"/><small>${q.points} puntos</small></legend><c:choose>
<c:when test="${q.type == 'OPCION_MULTIPLE'}"><c:forEach items="${q.options}" var="option"><label class="radio-option"><input type="radio" name="q_${q.id}" value="<c:out value='${option}'/>" required/><span><c:out value="${option}"/></span></label></c:forEach></c:when>
<c:when test="${q.type == 'VERDADERO_FALSO'}"><label class="radio-option"><input type="radio" name="q_${q.id}" value="Verdadero" required/>Verdadero</label><label class="radio-option"><input type="radio" name="q_${q.id}" value="Falso" required/>Falso</label></c:when>
<c:when test="${q.type == 'RELACIONAR'}"><c:forEach items="${q.labels}" var="label"><label class="matching-row"><strong><c:out value="${label}"/></strong><select name="q_${q.id}" required><option value="">Selecciona su relación</option><c:forEach items="${q.choices}" var="choice"><option value="<c:out value='${choice}'/>"><c:out value="${choice}"/></option></c:forEach></select></label></c:forEach></c:when>
<c:when test="${q.type == 'SELECCIONAR_ESPACIOS'}"><c:forEach begin="1" end="${q.gapCount}" var="gap"><label>Espacio ${gap}<select name="q_${q.id}" required><option value="">Selecciona un término</option><c:forEach items="${q.options}" var="choice"><option value="<c:out value='${choice}'/>"><c:out value="${choice}"/></option></c:forEach></select></label></c:forEach></c:when>
<c:otherwise><c:forEach begin="1" end="${q.gapCount}" var="gap"><label>Respuesta ${gap}<input name="q_${q.id}" maxlength="2000" required autocomplete="off"/></label></c:forEach></c:otherwise></c:choose></fieldset></c:forEach><button class="button">Enviar evaluación →</button></form></c:if>
<c:if test="${!content.examActive}"><p class="muted">La evaluación está desactivada.</p></c:if><c:if test="${role == 'ESTUDIANTE' && content.maxAttempts > 0 && fn:length(attempts) >= content.maxAttempts}"><p class="muted">Alcanzaste el máximo de intentos.</p></c:if><c:if test="${empty questions}"><p class="muted">La evaluación aún no tiene preguntas configuradas.</p></c:if><c:if test="${not empty attempts}"><h3>Intentos registrados</h3><div class="table-wrap"><table><thead><tr><th>Participante</th><th>Intento</th><th>Resultado</th><th>Estrellas</th><th>Detalle</th></tr></thead><tbody><c:forEach items="${attempts}" var="a"><tr><td><c:out value="${a.student.fullName}"/></td><td>${a.attemptNumber}</td><td><span class="badge ${a.passed ? 'positive' : 'warning'}">${a.percent}%</span></td><td>${a.stars} ★</td><td><a class="text-link" href="${ctx}/evaluaciones/intentos/${a.id}">Ver resultado →</a></td></tr></c:forEach></tbody></table></div></c:if></section></c:if>
<c:if test="${canLearn}"><section class="panel section-space" id="participacion"><span class="eyebrow">CONSTRUIMOS CONOCIMIENTO JUNTOS</span><h2>${content.type == 'FORO' ? 'Foro académico' : 'Conversación del contenido'}</h2><button type="button" class="button" data-modal-source="#post-new" data-modal-title="Publicar aporte">+ Publicar aporte</button><template id="post-new"><form action="${ctx}/contenidos/${content.id}/publicaciones" method="post" class="stack-form"><%@ include file="fragments/csrf.jspf" %><label>Comparte una idea o pregunta<textarea name="body" maxlength="4000" required placeholder="Tu perspectiva también aporta."></textarea></label><button class="button button-small">Publicar aporte →</button></form></template>
<c:forEach items="${posts}" var="row"><c:set var="post" value="${row.post}"/><article class="discussion ${post.parent != null ? 'reply' : ''}"><div class="discussion-author"><span class="avatar"><c:out value="${post.author.initials}"/></span><div><strong><c:out value="${post.author.fullName}"/></strong><small>${post.author.role} · ${post.createdAt.toLocalDate()}</small></div><c:if test="${post.parent != null}"><span class="badge">Respuesta a <c:out value="${post.parent.author.fullName}"/></span></c:if></div><p class="preserve-lines"><c:out value="${post.body}"/></p><c:if test="${!post.deleted}"><div class="discussion-actions"><form method="post" action="${ctx}/publicaciones/${post.id}/reaccion"><%@ include file="fragments/csrf.jspf" %><input name="contentId" type="hidden" value="${content.id}"/><select name="type" aria-label="Reacción"><option value="UTIL">Útil</option><option value="ME_GUSTA">Me gusta</option><option value="INTERESANTE">Interesante</option></select><button class="link-button">Reaccionar · ${row.reactionCount}</button></form><c:if test="${post.author.id != user.id}"><form method="post" action="${ctx}/publicaciones/${post.id}/valorar"><%@ include file="fragments/csrf.jspf" %><input name="contentId" type="hidden" value="${content.id}"/><select name="score" aria-label="Puntuación del aporte"><c:forEach begin="1" end="5" var="n"><option value="${n}">${n} ★</option></c:forEach></select><button class="link-button">Valorar · ${row.rating}</button></form></c:if></div>
<button type="button" class="button button-ghost button-small" data-modal-source="#reply-${post.id}" data-modal-title="Responder aporte">Responder</button><template id="reply-${post.id}"><form method="post" action="${ctx}/contenidos/${content.id}/publicaciones" class="stack-form"><%@ include file="fragments/csrf.jspf" %><input name="parentId" type="hidden" value="${post.id}"/><label>Tu respuesta<textarea name="body" maxlength="4000" required></textarea></label><button class="button button-small">Publicar respuesta</button></form></template>
<c:if test="${post.author.id == user.id}"><button type="button" class="button button-ghost button-small" data-modal-source="#edit-post-${post.id}" data-modal-title="Editar mi aporte">Editar mi aporte</button><template id="edit-post-${post.id}"><form method="post" action="${ctx}/publicaciones/${post.id}/editar" class="stack-form"><%@ include file="fragments/csrf.jspf" %><input name="contentId" type="hidden" value="${content.id}"/><label>Contenido<textarea name="body" maxlength="4000" required><c:out value="${post.body}"/></textarea></label><button class="button button-small">Guardar edición</button></form></template></c:if>
<c:if test="${post.author.id == user.id || canManage}"><form method="post" action="${ctx}/publicaciones/${post.id}/eliminar" data-confirm="¿Retirar esta publicación? Las respuestas se conservarán."><%@ include file="fragments/csrf.jspf" %><input name="contentId" type="hidden" value="${content.id}"/><button class="link-button danger">Retirar publicación</button></form></c:if></c:if></article></c:forEach><c:if test="${empty posts}"><p class="muted">Sé la primera persona en compartir una idea.</p></c:if></section></c:if>
</div><aside class="lesson-sidebar panel"><span class="eyebrow">CONTENIDO DEL CURSO</span><h3>Tu ruta</h3><c:forEach items="${syllabus}" var="row"><h4><c:out value="${row.module.title}"/></h4><c:forEach items="${row.contents}" var="lesson"><c:if test="${canLearn || lesson.preview}"><a class="lesson-nav ${lesson.id == content.id ? 'selected' : ''}" href="${ctx}${canLearn ? '/contenidos/' : '/vista-previa/'}${lesson.id}"><span>${completed.contains(lesson.id) ? '✓' : lesson.position}</span><c:out value="${lesson.title}"/></a></c:if></c:forEach></c:forEach></aside></div>
<%@ include file="fragments/footer.jspf" %>
