<%@ page pageEncoding="UTF-8" %>
<div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 xl:tw-grid-cols-3 tw-gap-5 tw-mt-4"><c:forEach items="${myCourses}" var="row"><article class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-xl tw-overflow-hidden"><img class="tw-w-full tw-aspect-video tw-object-cover tw-bg-gray-100" src="${ctx}/images/logos/inudiblack.png" alt="<c:out value='${row.course.title}'/>"/><div class="tw-p-5"><h3 class="tw-text-lg tw-font-semibold"><c:out value="${row.course.title}"/></h3><p class="tw-text-sm tw-text-gray-500">${row.moduleCount} módulos · ${row.contentCount} contenidos</p><c:if test="${row.nextContent != null && row.enrollment.current}"><p class="tw-text-sm">Siguiente: <c:out value="${row.nextContent.title}"/></p></c:if><div class="tw-flex tw-justify-between tw-text-sm tw-mt-4"><span>Progreso</span><strong>${row.percent}%</strong></div><progress class="tw-w-full" max="100" value="${row.percent}"></progress><p class="tw-text-gray-500 tw-text-sm tw-mt-2">Acceso hasta <c:out value="${row.enrollment.expiresAt.toLocalDate()}"/></p><c:choose><c:when test="${row.enrollment.current}"><a class="tw-inline-block tw-bg-green-700 tw-text-white tw-px-4 tw-py-2 tw-rounded-lg" href="${ctx}${row.nextContent != null ? '/contenidos/' : '/aula/cursos/'}${row.nextContent != null ? row.nextContent.id : row.course.id}">${row.percent > 0 ? 'Continuar curso' : 'Empezar curso'}</a></c:when><c:otherwise><span class="badge warning">Acceso no vigente</span></c:otherwise></c:choose></div></article></c:forEach></div><c:if test="${empty myCourses}"><div class="tw-bg-white tw-border tw-border-dashed tw-border-gray-300 tw-rounded-xl tw-p-8 tw-text-center tw-mt-4"><p>No tienes cursos inscritos.</p><a href="${ctx}/" class="tw-text-green-700 tw-font-semibold">Explorar cursos</a></div></c:if>
