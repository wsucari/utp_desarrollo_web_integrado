<%@ tag pageEncoding="UTF-8" %>
<%@ attribute name="course" required="true" type="pe.edu.inudi.domain.Course" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="info" value="${requestScope.courseInfo[course.id]}"/><c:set var="status" value="${empty info ? 'disponible' : info.status}"/>
<article class="tw-flex tw-h-full tw-min-h-[430px] tw-flex-col tw-overflow-hidden tw-rounded-lg tw-border tw-border-slate-200 tw-bg-white tw-shadow-sm hover:tw-shadow-md">
<a href="${pageContext.request.contextPath}/cursos/${course.id}" class="tw-relative tw-block tw-bg-slate-100"><img src="${pageContext.request.contextPath}/images/logos/inudiblack.png" alt="<c:out value='${course.title}'/>" class="tw-aspect-video tw-w-full tw-object-cover"/><span class="tw-absolute tw-left-3 tw-top-3 tw-rounded-full tw-px-3 tw-py-1 tw-text-xs tw-font-bold tw-shadow-sm ${status == 'inscrito' ? 'tw-bg-[#0E2F66] tw-text-white' : status == 'carrito' ? 'tw-bg-[#D4A017] tw-text-white' : 'tw-bg-white tw-text-[#0E2F66]'}">${status == 'inscrito' ? 'Inscrito' : status == 'carrito' ? 'En carrito' : 'Disponible'}</span></a>
<div class="tw-flex tw-flex-1 tw-flex-col tw-p-4"><a href="${pageContext.request.contextPath}/cursos/${course.id}" class="tw-text-lg tw-font-bold tw-leading-snug tw-text-[#0E2F66]"><c:out value="${course.title}"/></a><div class="tw-mt-2 tw-text-sm tw-text-[#64748B]"><c:if test="${not empty info}">${info.modules} módulos · </c:if><c:out value="${course.level}"/></div><p class="tw-mt-3 tw-line-clamp-2 tw-text-sm tw-leading-6 tw-text-[#64748B]"><c:out value="${course.description}"/></p><div class="tw-mt-auto tw-pt-4"><div class="tw-mb-3 tw-flex tw-items-center tw-justify-between tw-gap-2"><strong class="tw-text-lg tw-text-[#0E2F66]">S/. <fmt:formatNumber value="${course.price}" minFractionDigits="2" maxFractionDigits="2"/></strong><span class="tw-rounded-full tw-bg-slate-100 tw-px-2.5 tw-py-1 tw-text-xs tw-font-semibold tw-text-[#64748B]"><c:out value="${course.category}"/></span></div>
<c:choose><c:when test="${status == 'carrito'}"><a href="${pageContext.request.contextPath}/carrito" class="tw-block tw-rounded-md tw-bg-[#D4A017] tw-px-4 tw-py-2.5 tw-text-center tw-text-sm tw-font-bold tw-text-white">Ir al carrito</a></c:when><c:when test="${requestScope.role == 'ESTUDIANTE' && status != 'inscrito'}"><div class="tw-grid tw-grid-cols-2 tw-gap-2"><a href="${pageContext.request.contextPath}/cursos/${course.id}" class="tw-rounded-md tw-border tw-border-slate-300 tw-px-3 tw-py-2.5 tw-text-center tw-text-sm tw-font-bold tw-text-[#0E2F66]">Ver curso</a><form method="post" action="${pageContext.request.contextPath}/carrito/${course.id}"><input type="hidden" name="${requestScope._csrf.parameterName}" value="${requestScope._csrf.token}"/><button class="tw-w-full tw-border-0 tw-rounded-md tw-bg-[#0E2F66] tw-px-3 tw-py-2.5 tw-text-sm tw-font-bold tw-text-white">Agregar</button></form></div></c:when><c:otherwise><a href="${pageContext.request.contextPath}/cursos/${course.id}" class="tw-block tw-rounded-md tw-bg-[#0E2F66] tw-px-4 tw-py-2.5 tw-text-center tw-text-sm tw-font-bold tw-text-white">${status == 'inscrito' ? 'Continuar curso' : 'Ver curso'}</a></c:otherwise></c:choose>
</div></div></article>
